+// Copyright Epic Games, Inc. All Rights Reserved.
+
+#include "JsonSchema/JsonSchemaGeneratorEditor.h"
+
+#include "UObject/UnrealType.h"
+
+namespace
+{
+	void AddPropertyMetadata(const FProperty* Property, const TSharedRef<FJsonObject>& Metadata)
+	{
+		if (const FText ToolTip = Property->GetToolTipText(); !ToolTip.IsEmpty())
+		{
+			Metadata->SetStringField(TEXT("description"), ToolTip.ToString());
+		}
+
+		if (const FNumericProperty* NumericProperty = CastField<FNumericProperty>(Property))
+		{
+			if (NumericProperty->HasMetaData(TEXT("ClampMin")))
+			{
+				Metadata->SetNumberField(TEXT("minimum"), NumericProperty->GetDoubleMetaData(TEXT("ClampMin")));
+			}
+			if (NumericProperty->HasMetaData(TEXT("ClampMax")))
+			{
+				Metadata->SetNumberField(TEXT("maximum"), NumericProperty->GetDoubleMetaData(TEXT("ClampMax")));
+			}
+		}
+	}
+
+	void CollectPropertyMetadata(
+		const UStruct* Struct,
+		const FJsonSchemaPropertyFilter& PropertyFilter,
+		FJsonSchemaEditorMetadata& OutMetadata)
+	{
+		for (const FProperty* Property : TFieldRange<FProperty>(Struct))
+		{
+			if (PropertyFilter.IsPropertyIgnored(Property))
+			{
+				continue;
+			}
+
+			TSharedRef<FJsonObject> PropertyMetadata = MakeShared<FJsonObject>();
+			AddPropertyMetadata(Property, PropertyMetadata);
+			if (!PropertyMetadata->Values.IsEmpty())
+			{
+				OutMetadata.CurrentPropertyMemberPath = Property->GetAuthoredName();
+				OutMetadata.SetPropertyMetadataForCurrentPropertyMemberPath(PropertyMetadata);
+			}
+		}
+	}
+}
+
+FJsonSchemaEditorMetadata FJsonSchemaGeneratorEditor::FPropertyToJsonSchemaMetadata(
+	TNotNull<const FProperty*> Property,
+	const FJsonSchemaPropertyFilter& PropertyFilter,
+	const void* InstanceMemory)
+{
+	FJsonSchemaEditorMetadata EditorMetadata;
+	if (!PropertyFilter.IsPropertyIgnored(Property))
+	{
+		TSharedRef<FJsonObject> PropertyMetadata = MakeShared<FJsonObject>();
+		AddPropertyMetadata(Property, PropertyMetadata);
+		EditorMetadata.CurrentPropertyMemberPath = Property->GetAuthoredName();
+		EditorMetadata.SetPropertyMetadataForCurrentPropertyMemberPath(PropertyMetadata);
+	}
+	return EditorMetadata;
+}
+
+FJsonSchemaEditorMetadata FJsonSchemaGeneratorEditor::UStructToJsonSchemaMetadata(
+	TNotNull<const UStruct*> Struct,
+	const FJsonSchemaPropertyFilter& PropertyFilter,
+	const void* InstanceMemory)
+{
+	FJsonSchemaEditorMetadata EditorMetadata;
+
+	const FText ToolTip = Struct->GetToolTipText();
+	if (!ToolTip.IsEmpty())
+	{
+		EditorMetadata.RootStructMetadata = MakeShared<FJsonObject>();
+		EditorMetadata.RootStructMetadata->SetStringField(TEXT("description"), ToolTip.ToString());
+	}
+
+	CollectPropertyMetadata(Struct, PropertyFilter, EditorMetadata);
+	return EditorMetadata;
+}
