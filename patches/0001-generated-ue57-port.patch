+	void SetType(const TSharedRef<FJsonObject>& Schema, const TCHAR* Type)
+	{
+		Schema->SetStringField(TEXT("type"), Type);
+	}
+
+	void AddEnumValues(const UEnum* Enum, const TSharedRef<FJsonObject>& Schema)
+	{
+		if (!Enum)
+		{
+			return;
+		}
+
+		TArray<TSharedPtr<FJsonValue>> Values;
+		for (int32 Index = 0; Index < Enum->NumEnums(); ++Index)
+		{
+			const FString Name = Enum->GetAuthoredNameStringByIndex(Index);
+			if (!Name.EndsWith(TEXT("_MAX"), ESearchCase::CaseSensitive))
+			{
+				Values.Add(MakeShared<FJsonValueString>(Name));
+			}
+		}
+
+		Schema->SetStringField(TEXT("type"), TEXT("string"));
+		Schema->SetStringField(TEXT("title"), Enum->GetName());
+		Schema->SetArrayField(TEXT("enum"), Values);
+	}
+
+	const TSharedPtr<FJsonObject>* FindMetadataForProperty(
+		const FJsonSchemaEditorMetadata* EditorMetadata,
+		const FString& PropertyMemberPath,
+		const FString& JsonKey)
+	{
+		if (!EditorMetadata)
+		{
+			return nullptr;
+		}
+
+		const FJsonSchemaEditorMetadata::FJsonSchemaPropertyMemberPathToPropertyMetadataMap& Map =
+			EditorMetadata->GetPropertyMemberPathToPropertyMetadataMap();
+
+		if (const TSharedPtr<FJsonObject>* Found = Map.Find(PropertyMemberPath))
+		{
+			return Found;
+		}
+		return Map.Find(JsonKey);
+	}
+
+	void ApplyEditorMetadata(
+		const FJsonSchemaEditorMetadata* EditorMetadata,
+		const FString& PropertyMemberPath,
+		const FString& JsonKey,
+		const TSharedRef<FJsonObject>& Schema)
+	{
+		const TSharedPtr<FJsonObject>* Metadata = FindMetadataForProperty(EditorMetadata, PropertyMemberPath, JsonKey);
+		if (!Metadata || !Metadata->IsValid())
+		{
+			return;
+		}
+
+		for (const TPair<FString, TSharedPtr<FJsonValue>>& Pair : (*Metadata)->Values)
+		{
+			Schema->SetField(Pair.Key, Pair.Value);
+		}
+	}
+
+	bool IsRequiredInputParameter(const FProperty* Property, const FJsonSchemaPropertyFilter& PropertyFilter, const FString& JsonKey)
+	{
+		return Property
+			&& Property->HasAnyPropertyFlags(CPF_Parm)
+			&& !Property->HasAnyPropertyFlags(CPF_ReturnParm | CPF_OutParm)
+			&& PropertyFilter.IsPropertyRequired(JsonKey);
+	}
+}
