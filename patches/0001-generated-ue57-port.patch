+int32 FWatchedSandboxRepository::IndexOf(const FString& InDirectory) const
+{
+	return CachedSandboxData.IndexOfByPredicate([&InDirectory](const FSandboxData& Data)
+	{
+		return FPaths::IsSamePath(Data.AbsPath, InDirectory);
+	});
+}
