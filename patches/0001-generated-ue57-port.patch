+			ExpectExceptionContains(TEXT("ConfigSettingsToolset"));
+		});
+
+		It(TEXT("raises error for nonexistent section"), [this]()
+		{
+			ExceptionHandler->CaptureErrorsIn([this]()
+			{
+				UConfigSettingsToolset::SaveSection(
