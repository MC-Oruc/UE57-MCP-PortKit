+        modifier.set_skeletal_mesh(mesh)
+        modifier.remove_bone('joint2', True)
+        modifier.commit_skeleton_to_skeletal_mesh()
+        eas = unreal.get_editor_subsystem(unreal.EditorAssetSubsystem)
