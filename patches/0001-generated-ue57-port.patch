+	{
+		return FKismetEditorUtilities::CreateBlueprint(ParentClass, InParent, Name, BlueprintType, UModelContextProtocolEditorToolLibraryBlueprint::StaticClass(), UBlueprintGeneratedClass::StaticClass(), CallingContext);
