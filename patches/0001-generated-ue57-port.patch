+#pragma once
+
+#include "CoreMinimal.h"
+#include "JsonObjectConverter.h"
+
+struct FJsonSchemaPropertyFilter
+{
+	using CustomCallback = TDelegate<bool(const FProperty* Property, const FString& ParameterDefaultString, const TSharedRef<FJsonObject>& OutputSchema)>;
+
+	FJsonSchemaPropertyFilter() = default;
+
+	FJsonSchemaPropertyFilter(
+		EPropertyFlags InCheckFlags,
+		EPropertyFlags InSkipFlags = CPF_None,
+		TOptional<TSet<FString>> InRequiredPropertyMemberPaths = TOptional<TSet<FString>>(),
+		TOptional<TSet<FString>> InSkipPropertyMemberPaths = TOptional<TSet<FString>>())
+		: CheckFlags(InCheckFlags)
+		, SkipFlags(InSkipFlags)
+		, RequiredPropertyMemberPaths(MoveTemp(InRequiredPropertyMemberPaths))
+		, SkipPropertyMemberPaths(MoveTemp(InSkipPropertyMemberPaths))
+	{
+	}
+
+	EPropertyFlags CheckFlags = CPF_None;
+	EPropertyFlags SkipFlags = CPF_None;
+	TOptional<TSet<FString>> RequiredPropertyMemberPaths;
+	TOptional<TSet<FString>> SkipPropertyMemberPaths;
+	CustomCallback* CustomCb = nullptr;
+
+	bool IsPropertyIgnored(const FProperty* Property) const
+	{
+		if (!Property || Property->HasAnyPropertyFlags(SkipFlags))
+		{
+			return true;
+		}
+
+		if (CheckFlags != CPF_None && !Property->HasAnyPropertyFlags(CheckFlags))
+		{
+			return true;
+		}
+
+		const FString AuthoredName = Property->GetAuthoredName();
+		const FString JsonKey = PropertyAuthoredNameToJsonKey(AuthoredName);
+		return SkipPropertyMemberPaths.IsSet()
+			&& (SkipPropertyMemberPaths->Contains(AuthoredName) || SkipPropertyMemberPaths->Contains(JsonKey));
+	}
+
+	bool IsPropertyRequired(const FString& PropertyMemberPath) const
+	{
+		return !RequiredPropertyMemberPaths.IsSet() || RequiredPropertyMemberPaths->Contains(PropertyMemberPath);
+	}
+
+	FString PropertyAuthoredNameToJsonKey(const FString& PropertyAuthoredName) const
+	{
+		return FJsonObjectConverter::StandardizeCase(PropertyAuthoredName);
+	}
+};
