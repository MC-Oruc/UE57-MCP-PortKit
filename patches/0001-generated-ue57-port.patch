+		UEdGraphPin* FuncCallExecPin = K2Schema->FindExecutionPin(*SetVariablesCallNode, EGPD_Input);
+		UEdGraphPin* FuncCallThenPin = K2Schema->FindExecutionPin(*SetVariablesCallNode, EGPD_Output);
+
+		if (FuncCallValuePin == nullptr)
