+{
+	UEdGraph* Graph = FBlueprintEditorUtils::FindUserConstructionScript(BP);
+	if (Graph == nullptr)
+	{
+		Graph = FKismetEditorUtilities::CreateUserConstructionScript(BP);
+	}
+	return Graph;
+}
