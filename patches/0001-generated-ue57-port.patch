+	 */
+	UFUNCTION(meta = (AICallable))
+	static bool IsPIERunning();
+
+private:
+	static TSharedPtr<FJsonObject> CVarToJson(IConsoleObject* CVar);
+
+	friend class FEditorAppToolsetSpec;
+};
