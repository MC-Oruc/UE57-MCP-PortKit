-	UE_LOGF(LogMCPClientToolset, Log,
-		"MCPClientToolset '%ls': starting Streamable HTTP handshake at %ls",
-		*Config.Name, *Config.ServerUrl);
-
-	TSharedPtr<FJsonObject> InitParams = MakeShared<FJsonObject>();
