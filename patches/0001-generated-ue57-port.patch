-				Canvas.DrawDot(OX, OY, 5, FColor(255, 255, 0, 255));
-				Canvas.DrawString(OX + 8, OY - 8, TEXT("ORIGIN(0,0)"), FColor(255, 255, 0, 255), 2, true);
-			}
-
-			const int32 LegendX = Size.X - 120;
-			const int32 LegendY = Size.Y - 50;
