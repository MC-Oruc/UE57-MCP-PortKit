+
+    # -------------------------------------------------------------------------
+    # Asset creation
+    # -------------------------------------------------------------------------
+
+    @_tool_call
+    @staticmethod
+    def create_material(folder_path: str, asset_name: str) -> unreal.Material:
+        """Creates a new empty Material asset.
