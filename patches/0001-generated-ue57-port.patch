+void AnalyzeFilesMarkedRemoved(
+	IPlatformFile& InPlatformFile, const TConstArrayView<FNonSandboxPath>& InFilesMarkedForRemove,
+	TFunctionRef<EBreakBehavior(const FNonSandboxPath&)> InHandleRemovedFile
+	)
+{
