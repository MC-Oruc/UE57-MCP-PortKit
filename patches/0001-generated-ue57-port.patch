+// Forward declarations — ImportPropertyWithNotify and ImportStructFieldsWithNotify are mutually recursive.
+bool ImportPropertyWithNotify(
+	const TSharedPtr<FJsonValue>& NewJson,
+	FProperty* Property,
+	void* PropertyMemory,
+	FPropertyImportContext Ctx);
