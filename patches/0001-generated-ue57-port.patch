+    'y':        ('Math|Vector|BreakVector',       'Y'),
+    'z':        ('Math|Vector|BreakVector',       'Z'),
+    'pitch':    ('Math|Rotator|BreakRotator',     'Pitch'),
+    'yaw':      ('Math|Rotator|BreakRotator',     'Yaw'),
