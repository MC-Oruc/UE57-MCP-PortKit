+	FString Identifier;
+
+	/** Root widget to observe. Invalid (null) when bRoot is true. */
+	TWeakPtr<SWidget> RootWidget;
+
+	/** When true, this is the root observer covering all visible windows (RootWidget is ignored). */
+	bool bRoot = false;
+
