+        with cls._editor_event_loop_manager_lock:
+            if cls._editor_event_loop_manager is None:
+                cls._editor_event_loop_manager = (
+                    cls._editor_event_loop_manager_exit_stack.enter_context(
+                        EditorEventLoopManager()
