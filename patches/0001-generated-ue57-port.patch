+	{
+		FPCGPinInfo Info;
+		Info.Name = Property.Label.ToString();
+		Info.Type = Property.AllowedTypes.ToDisplayText().ToString();
+		Info.Description = Property.Tooltip.ToString();
+		return Info;
+	});
+
+	return PinInfos;
+}
