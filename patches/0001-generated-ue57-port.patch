+	TArray<FDataRegistrySourceSummary> BuildSourceSummariesFromRegistryProperty(
+		const UDataRegistry& Registry, const FName PropertyName)
+	{
+		const FArrayProperty* ArrayProperty = FindFProperty<FArrayProperty>(UDataRegistry::StaticClass(), PropertyName);
+		const FObjectPropertyBase* SourceObjectProperty = ArrayProperty != nullptr
+			? CastField<FObjectPropertyBase>(ArrayProperty->Inner)
+			: nullptr;
+
+		if (ArrayProperty == nullptr || SourceObjectProperty == nullptr)
+		{
+			RaiseToolError(FString::Printf(
+				TEXT("DataRegistry property '%s' could not be read."), *PropertyName.ToString()));
+			return TArray<FDataRegistrySourceSummary>();
+		}
+
+		const void* ArrayValue = ArrayProperty->ContainerPtrToValuePtr<void>(&Registry);
+		FScriptArrayHelper ArrayHelper(ArrayProperty, ArrayValue);
+
+		TArray<FDataRegistrySourceSummary> Result;
+		Result.Reserve(ArrayHelper.Num());
+		for (int32 Index = 0; Index < ArrayHelper.Num(); ++Index)
+		{
+			UObject* SourceObject = SourceObjectProperty->GetObjectPropertyValue(ArrayHelper.GetRawPtr(Index));
+			Result.Add(BuildSourceSummary(Cast<UDataRegistrySource>(SourceObject)));
+		}
+		return Result;
+	}
