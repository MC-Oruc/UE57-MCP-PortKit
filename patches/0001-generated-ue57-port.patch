+_SUBTRACT_TYPE_IDS: frozenset[str] = frozenset(
+    tid for tid, op in _TYPE_ID_TO_OP.items() if op == '-'
+)
+_MAKE_LITERAL_COLLAPSED: frozenset[str] = frozenset(_WILDCARD_LITERAL_NODES.values())
