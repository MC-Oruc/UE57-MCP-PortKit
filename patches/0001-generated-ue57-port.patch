+            unreal.Paths.project_saved_dir(),
+            prefix="agent_script_", extension=".py"
+        )
+        try:
+            with open(script_path, "w", encoding="utf-8") as f:
+                f.write(script)
+            yield script_path
+        finally:
+            os.unlink(script_path)
