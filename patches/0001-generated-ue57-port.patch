+			const bool bAdded = Module.AddTool(MockTool.ToSharedRef());
+			TestTrue("Tool should be registered", bAdded);
+
+			if (bAdded)
+			{
+				Module.RemoveTool(MockTool.ToSharedRef());
+			}
+		});
+	});
