+	{
+		TSharedPtr<FJsonObject> JsonObject = MakeShared<FJsonObject>();
+		JsonObject->SetNumberField(TEXT("x"), Vector.X);
+		JsonObject->SetNumberField(TEXT("y"), Vector.Y);
+		JsonObject->SetNumberField(TEXT("z"), Vector.Z);
