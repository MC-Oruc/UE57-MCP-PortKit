+FVector2D UEditorAppToolset::WorldPosToScreenCoords(FVector Position)
+{
+	if (!GEditor)
+	{
+		RaiseEditorToolsetScriptError(TEXT("Editor not found."));
+		return FVector2D::ZeroVector;
+	}
+	FVector2D ScreenCoords;
+	if (!WorldToScreen(Position, ScreenCoords))
+	{
+		RaiseEditorToolsetScriptError(TEXT("Unable to convert position into screen space."));
+		return FVector2D::ZeroVector;
+	}
+	FIntPoint Size;
+	if (!GetLevelViewportSize(Size))
+	{
+		RaiseEditorToolsetScriptError(TEXT("Unable to retrieve viewport size."));
+		return FVector2D::ZeroVector;
+	}
+	return FVector2D(ScreenCoords.X / Size.X, ScreenCoords.Y / Size.Y);
+}
+
+FVector UEditorAppToolset::ScreenCoordsToWorld(FVector2D Coords, float TraceDistance)
+{
+	if (Coords.X < 0 || Coords.X > 1 || Coords.Y < 0 || Coords.Y > 1)
+	{
+		RaiseEditorToolsetScriptError(FString::Printf(
+			TEXT("Invalid viewport coords (%f, %f)."), Coords.X, Coords.Y));
+		return FVector::ZeroVector;
+	}
+	if (!GEditor)
+	{
+		RaiseEditorToolsetScriptError(TEXT("Editor not found."));
+		return FVector::ZeroVector;
+	}
+	UWorld* World = GEditor->GetEditorWorldContext().World();
+	if (!World)
+	{
+		RaiseEditorToolsetScriptError(TEXT("No world to query."));
+		return FVector::ZeroVector;
+	}
+	FIntPoint Size;
+	if (!GetLevelViewportSize(Size))
+	{
+		RaiseEditorToolsetScriptError(TEXT("Unable to retrieve viewport size."));
+		return FVector::ZeroVector;
+	}
+	FVector Origin, Direction;
+	const FVector2D PixelCoords(Coords.X * Size.X, Coords.Y * Size.Y);
+	if (!ScreenToWorld(PixelCoords, Origin, Direction))
+	{
+		RaiseEditorToolsetScriptError(TEXT("Unable to convert screen coordinates into world space."));
+		return FVector::ZeroVector;
+	}
+	FHitResult HitResult;
+	TArray<AActor*> ActorsToIgnore;
+	const bool bHit = UKismetSystemLibrary::LineTraceSingle(
+		World,
+		Origin,
+		Origin + Direction * TraceDistance,
+		ETraceTypeQuery::TraceTypeQuery1,
+		true,
+		ActorsToIgnore,
+		EDrawDebugTrace::None,
+		HitResult,
+		true);
+	if (!bHit)
+	{
+		RaiseEditorToolsetScriptError(TEXT("Unable to find a solid surface at the given screen coordinates."));
+		return FVector::ZeroVector;
+	}
+	return HitResult.Location;
+}
