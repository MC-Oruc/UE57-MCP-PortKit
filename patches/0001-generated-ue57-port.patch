+    return hasattr(unreal.MaterialEditingLibrary, name)
+
+
+def _unsupported_material_tools() -> set[str]:
+    unsupported: set[str] = set()
+
+    if not (_has_material_api('get_material_expressions') and
+            _has_material_api('get_material_function_expressions')):
+        unsupported.update({'get_expressions', 'list_parameter_groups'})
+
+    if not _has_material_api('get_material_expression_output_names'):
+        unsupported.add('get_expression_output_names')
+
+    if not _has_material_api('disconnect_material_expressions'):
+        unsupported.add('disconnect_expressions')
+
+    if not (_has_material_api('get_inputs_for_material_expression') and
+            _has_material_api('get_inputs_for_material_function_expression') and
+            _has_material_api('get_input_node_output_name_for_material_expression')):
+        unsupported.add('get_expression_inputs')
+
+    if not _has_material_api('disconnect_material_property'):
+        unsupported.add('disconnect_from_output')
+
+    if not _has_material_api('delete_unused_expressions'):
+        unsupported.add('delete_unused_expressions')
+
+    if not _has_material_api('get_materials_referencing_function'):
+        unsupported.add('get_referencing_materials')
+
+    return unsupported
+
+
+_UNSUPPORTED_TOOLS = _unsupported_material_tools()
+
+
+def _tool_call(func):
+    underlying = getattr(func, '__func__', func)
+    if getattr(underlying, '__name__', '') in _UNSUPPORTED_TOOLS:
+        return func
+    return _ORIGINAL_TOOL_CALL(func)
