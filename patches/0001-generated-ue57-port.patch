+        # drive letter can be determined (non-Windows or single-drive layout).
+        alt_drive = "D:" if drive.upper() != "D:" else "C:"
+        cross_drive_path = alt_drive + "\\evil\\path"
+        with self.assertRaises(ValueError) as ctx:
