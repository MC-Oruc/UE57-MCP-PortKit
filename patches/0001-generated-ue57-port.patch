diff --git a/Plugins/EditorToolset/Source/EditorToolset/Private/CurveTableTools.cpp b/Plugins/EditorToolset/Source/EditorToolset/Private/CurveTableTools.cpp
new file mode 100644
index 0000000..67bdabb
