+		const bool bDirectoryExistedAlready = PlatformFile.DirectoryExists(*BaseDirectory);
+		const bool bHasCreatedDirectory = !bDirectoryExistedAlready && PlatformFile.CreateDirectoryTree(*BaseDirectory);
