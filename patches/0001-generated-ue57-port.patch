@@ -0,0 +1,124 @@
+# Copyright Epic Games, Inc. All Rights Reserved.
+
+"""UE 5.7-safe loader for EditorToolset Python toolsets."""
+
+from importlib import util
+from pathlib import Path
+import sys
+import types
+
+import unreal
+
+from toolset_registry.registration import Registration
+
+
+_TOOLSET_MODULES = (
+    'blueprint_node',
+    'blueprint_layout',
+    'blueprint_dsl',
+    'asset',
+    'blueprint',
+    'actor',
+    'curve_table',
+    'data_asset',
+    'data_table',
+    'material',
+    'material_instance',
+    'object',
+    'primitive',
+    'programmatic',
+    'scene',
+    'skeletal_mesh',
+    'static_mesh',
+    'string_table',
+    'texture',
+)
+
+_TOOLSET_CLASSES = (
+    ('actor', 'ActorTools'),
+    ('asset', 'AssetTools'),
+    ('blueprint', 'BlueprintTools'),
+    ('curve_table', 'CurveTableTools'),
+    ('data_asset', 'DataAssetTools'),
+    ('data_table', 'DataTableTools'),
+    ('material', 'MaterialTools'),
+    ('material_instance', 'MaterialInstanceTools'),
+    ('object', 'ObjectTools'),
+    ('primitive', 'PrimitiveTools'),
+    ('scene', 'SceneTools'),
+    ('skeletal_mesh', 'SkeletalMeshTools'),
+    ('static_mesh', 'StaticMeshTools'),
+    ('string_table', 'StringTableTools'),
+    ('programmatic', 'ProgrammaticToolset'),
+    ('texture', 'TextureTools'),
+)
+
+_BLUEPRINT_REQUIRED_ATTRS = (
+    ('SoCBlueprintGraphEditorBridge', None),
+    ('SoCBlueprintEditorBridgeLibrary', 'list_graphs'),
+    ('SoCBlueprintEditorBridgeLibrary', 'list_graph_names'),
+    ('SoCBlueprintEditorBridgeLibrary', 'list_member_variable_names'),
+)
+
+
+def _has_unreal_attr(owner_name: str, attr_name: str | None = None) -> bool:
+    owner = getattr(unreal, owner_name, None)
+    if owner is None:
+        return False
+    return attr_name is None or hasattr(owner, attr_name)
+
+
+def _is_toolset_supported(module_name: str, class_name: str) -> bool:
+    if class_name == 'BlueprintTools':
+        return all(_has_unreal_attr(owner, attr) for owner, attr in _BLUEPRINT_REQUIRED_ATTRS)
+    if class_name == 'MaterialTools':
+        return _has_unreal_attr('MaterialEditingLibrary')
+    return True
+
+
+def _get_toolsets_package() -> types.ModuleType:
+    package_name = 'editor_toolset.toolsets'
+    package = sys.modules.get(package_name)
+    if package is not None and getattr(package, '_ue57_safe_loader', False):
+        return package
+
+    package = types.ModuleType(package_name)
+    package.__path__ = [str(Path(__file__).resolve().parent / 'toolsets')]
+    package._ue57_safe_loader = True
+    sys.modules[package_name] = package
+
+    parent = sys.modules.get('editor_toolset')
+    if parent is not None:
+        setattr(parent, 'toolsets', package)
+
+    return package
+
+
+def _load_module(package: types.ModuleType, name: str):
+    real_name = f'{package.__name__}.{name}'
+    module = sys.modules.get(real_name)
+    if module is not None:
+        setattr(package, name, module)
+        return module
+
+    module_name = f'_editor_toolset_ue57_{name}'
+    module_path = Path(package.__path__[0]) / f'{name}.py'
+    spec = util.spec_from_file_location(module_name, module_path)
+    assert spec and spec.loader
+
+    module = util.module_from_spec(spec)
+    sys.modules[module_name] = module
+    sys.modules[real_name] = module
+    setattr(package, name, module)
+    spec.loader.exec_module(module)
+    return module
+
+
+def create_registration() -> Registration:
+    package = _get_toolsets_package()
+    modules = {name: _load_module(package, name) for name in _TOOLSET_MODULES}
+    return Registration([
+        getattr(modules[module_name], class_name)
+        for module_name, class_name in _TOOLSET_CLASSES
+        if _is_toolset_supported(module_name, class_name)
+    ])
