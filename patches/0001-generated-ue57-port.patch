+FString PCGToolsetLibrary::Graph::VerbosityToString(ELogVerbosity::Type Verbosity)
+{
+	switch (Verbosity)
+	{
+		case ELogVerbosity::Error:
+			return TEXT("Error");
+		case ELogVerbosity::Warning:
+			return TEXT("Warning");
+		default:
+			return TEXT("Feedback");
+	}
+}
