+_BLUEPRINT_REPLICATION_NONE = 0
+_BLUEPRINT_REPLICATION_REPLICATED = 1
+_BLUEPRINT_REPLICATION_REP_NOTIFY = 2
+
+
+def _blueprint_replication_to_int(replication) -> int:
+    try:
+        return int(replication)
+    except (TypeError, ValueError):
+        name = str(replication).split('.')[-1].upper()
+        return {
+            'NONE': _BLUEPRINT_REPLICATION_NONE,
+            'REPLICATED': _BLUEPRINT_REPLICATION_REPLICATED,
+            'REP_NOTIFY': _BLUEPRINT_REPLICATION_REP_NOTIFY,
+        }.get(name, _BLUEPRINT_REPLICATION_NONE)
+
