+TArray<FString> UPluginToolset::ListEnabledPlugins()
+{
+	TArray<FString> Names;
+	for (const TSharedRef<IPlugin>& Plugin : IPluginManager::Get().GetEnabledPlugins())
+	{
+		Names.Add(Plugin->GetName());
+	}
+	Names.Sort();
+	return Names;
+}
