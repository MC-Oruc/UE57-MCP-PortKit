+				TestFalse(TEXT("Non-empty"), Names.IsEmpty());
+			});
+			ExpectNoException();
+		});
+
+		It(TEXT("raises error for nonexistent container"), [this]()
+		{
+			ExceptionHandler->CaptureErrorsIn([this]()
+			{
