-			int32 X = 0, Y = 0, W = 0, H = 0;
-			bool Overlaps(int32 OX, int32 OY, int32 OW, int32 OH) const
-			{
-				return !(OX + OW < X || OX > X + W || OY + OH < Y || OY > Y + H);
-			}
-		};
