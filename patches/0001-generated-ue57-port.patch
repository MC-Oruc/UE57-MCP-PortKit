+	bool WantsField(const FString& NormalizedAttributeName, const TCHAR* FieldName)
+	{
+		return NormalizedAttributeName.IsEmpty() || NormalizedAttributeName.Equals(FieldName, ESearchCase::IgnoreCase);
+	}
+
+	TSharedPtr<FJsonObject> PointToJson(const FPCGPoint& Point, const FString& NormalizedAttributeName)
+	{
+		TSharedPtr<FJsonObject> JsonObject = MakeShared<FJsonObject>();
+		if (WantsField(NormalizedAttributeName, TEXT("Transform")))
+		{
+			JsonObject->SetObjectField(TEXT("transform"), TransformToJson(Point.Transform));
+		}
+		if (WantsField(NormalizedAttributeName, TEXT("Location")) || WantsField(NormalizedAttributeName, TEXT("Position")))
+		{
+			JsonObject->SetObjectField(TEXT("location"), VectorToJson(Point.Transform.GetLocation()));
+		}
+		if (WantsField(NormalizedAttributeName, TEXT("Rotation")))
+		{
+			JsonObject->SetObjectField(TEXT("rotation"), RotatorToJson(Point.Transform.Rotator()));
+		}
+		if (WantsField(NormalizedAttributeName, TEXT("Scale")))
+		{
+			JsonObject->SetObjectField(TEXT("scale"), VectorToJson(Point.Transform.GetScale3D()));
+		}
+		if (WantsField(NormalizedAttributeName, TEXT("Density")))
+		{
+			JsonObject->SetNumberField(TEXT("density"), Point.Density);
+		}
+		if (WantsField(NormalizedAttributeName, TEXT("BoundsMin")))
+		{
+			JsonObject->SetObjectField(TEXT("boundsMin"), VectorToJson(Point.BoundsMin));
+		}
+		if (WantsField(NormalizedAttributeName, TEXT("BoundsMax")))
+		{
+			JsonObject->SetObjectField(TEXT("boundsMax"), VectorToJson(Point.BoundsMax));
+		}
+		if (WantsField(NormalizedAttributeName, TEXT("Color")))
+		{
+			JsonObject->SetObjectField(TEXT("color"), Vector4ToJson(Point.Color));
+		}
+		if (WantsField(NormalizedAttributeName, TEXT("Steepness")))
+		{
+			JsonObject->SetNumberField(TEXT("steepness"), Point.Steepness);
+		}
+		if (WantsField(NormalizedAttributeName, TEXT("Seed")))
+		{
+			JsonObject->SetNumberField(TEXT("seed"), Point.Seed);
+		}
+		if (WantsField(NormalizedAttributeName, TEXT("MetadataEntry")))
+		{
+			JsonObject->SetNumberField(TEXT("metadataEntry"), static_cast<double>(Point.MetadataEntry));
+		}
+
+		return JsonObject;
+	}
+
+	TSharedPtr<FJsonObject> PointDataElementToJson(const UPCGBasePointData* PointData, const int32 Index, const FString& NormalizedAttributeName)
+	{
+		check(PointData);
+
+		TSharedPtr<FJsonObject> JsonObject = MakeShared<FJsonObject>();
+		const FTransform& Transform = PointData->GetTransform(Index);
+		if (WantsField(NormalizedAttributeName, TEXT("Transform")))
+		{
+			JsonObject->SetObjectField(TEXT("transform"), TransformToJson(Transform));
+		}
+		if (WantsField(NormalizedAttributeName, TEXT("Location")) || WantsField(NormalizedAttributeName, TEXT("Position")))
+		{
+			JsonObject->SetObjectField(TEXT("location"), VectorToJson(Transform.GetLocation()));
+		}
+		if (WantsField(NormalizedAttributeName, TEXT("Rotation")))
+		{
+			JsonObject->SetObjectField(TEXT("rotation"), RotatorToJson(Transform.Rotator()));
+		}
+		if (WantsField(NormalizedAttributeName, TEXT("Scale")))
+		{
+			JsonObject->SetObjectField(TEXT("scale"), VectorToJson(Transform.GetScale3D()));
+		}
+		if (WantsField(NormalizedAttributeName, TEXT("Density")))
+		{
+			JsonObject->SetNumberField(TEXT("density"), PointData->GetDensity(Index));
+		}
+		if (WantsField(NormalizedAttributeName, TEXT("BoundsMin")))
+		{
+			JsonObject->SetObjectField(TEXT("boundsMin"), VectorToJson(PointData->GetBoundsMin(Index)));
+		}
+		if (WantsField(NormalizedAttributeName, TEXT("BoundsMax")))
+		{
+			JsonObject->SetObjectField(TEXT("boundsMax"), VectorToJson(PointData->GetBoundsMax(Index)));
+		}
+		if (WantsField(NormalizedAttributeName, TEXT("Color")))
+		{
+			JsonObject->SetObjectField(TEXT("color"), Vector4ToJson(PointData->GetColor(Index)));
+		}
+		if (WantsField(NormalizedAttributeName, TEXT("Steepness")))
+		{
+			JsonObject->SetNumberField(TEXT("steepness"), PointData->GetSteepness(Index));
+		}
+		if (WantsField(NormalizedAttributeName, TEXT("Seed")))
+		{
+			JsonObject->SetNumberField(TEXT("seed"), PointData->GetSeed(Index));
+		}
+		if (WantsField(NormalizedAttributeName, TEXT("MetadataEntry")))
+		{
+			JsonObject->SetNumberField(TEXT("metadataEntry"), static_cast<double>(PointData->GetMetadataEntry(Index)));
+		}
+
+		return JsonObject;
+	}
+
+	bool IsSupportedPointField(const FString& AttributeName)
+	{
+		static const TSet<FString> SupportedFields = {
+			TEXT("transform"), TEXT("location"), TEXT("position"), TEXT("rotation"), TEXT("scale"),
+			TEXT("density"), TEXT("boundsmin"), TEXT("boundsmax"), TEXT("color"),
+			TEXT("steepness"), TEXT("seed"), TEXT("metadataentry")
+		};
+
+		return AttributeName.IsEmpty() || SupportedFields.Contains(AttributeName.ToLower());
+	}
+
+	TSharedPtr<FJsonObject> TaggedDataToJson(const FPCGTaggedData& TaggedData, const FString& AttributeName, const int32 StartIndex, const int32 EndIndex)
+	{
+		const UPCGData* Data = TaggedData.Data.Get();
+		if (!Data)
+		{
+			return {};
+		}
+
+		const int32 NumElements = PCGHelpers::GetNumberOfElements(Data);
+		if (StartIndex < 0 || StartIndex > NumElements)
+		{
+			FScriptErrorBridge::RaiseScriptError(FString::Printf(TEXT("Error: StartIndex (%d) out of bounds. Data has %d elements."), StartIndex, NumElements));
+			return {};
+		}
+
+		const int32 EffectiveEnd = EndIndex == -1 ? NumElements : FMath::Min(EndIndex, NumElements);
+		if (EffectiveEnd < StartIndex)
+		{
+			FScriptErrorBridge::RaiseScriptError(FString::Printf(TEXT("Error: EndIndex (%d) is before StartIndex (%d)."), EndIndex, StartIndex));
+			return {};
+		}
+
+		TSharedPtr<FJsonObject> JsonObject = MakeShared<FJsonObject>();
+		JsonObject->SetStringField(TEXT("dataType"), Data->GetClass()->GetName());
+		JsonObject->SetStringField(TEXT("pin"), TaggedData.Pin.ToString());
+		JsonObject->SetNumberField(TEXT("totalElements"), NumElements);
+		JsonObject->SetNumberField(TEXT("startIndex"), StartIndex);
+		JsonObject->SetNumberField(TEXT("endIndex"), EffectiveEnd);
+
+		TArray<TSharedPtr<FJsonValue>> Tags;
+		for (const FString& Tag : TaggedData.Tags)
+		{
+			Tags.Add(MakeShared<FJsonValueString>(Tag));
+		}
+		JsonObject->SetArrayField(TEXT("tags"), Tags);
+
+		const UPCGBasePointData* PointData = Cast<UPCGBasePointData>(Data);
+		if (!PointData)
+		{
+			JsonObject->SetBoolField(TEXT("supportedElementSerialization"), false);
+			return JsonObject;
+		}
+
+		const FString NormalizedAttributeName = AttributeName.TrimStartAndEnd();
+		if (!IsSupportedPointField(NormalizedAttributeName))
+		{
+			FScriptErrorBridge::RaiseScriptError(FString::Printf(
+				TEXT("Error: AttributeName '%s' is not supported by the UE 5.7 PCG data view subset. Supported built-in point fields: Transform, Location, Position, Rotation, Scale, Density, BoundsMin, BoundsMax, Color, Steepness, Seed, MetadataEntry."),
+				*AttributeName));
+			return {};
+		}
+
+		for (int32 Index = StartIndex; Index < EffectiveEnd; ++Index)
+		{
+			JsonObject->SetObjectField(FString::Printf(TEXT("element_%d"), Index), PointDataElementToJson(PointData, Index, NormalizedAttributeName));
+		}
+
+		return JsonObject;
+	}
+
+	AActor* FindLevelActorByLabel(const FString& ActorLabel)
+	{
+		UEditorActorSubsystem* EditorActorSubsystem = GEditor ? GEditor->GetEditorSubsystem<UEditorActorSubsystem>() : nullptr;
+		if (!EditorActorSubsystem)
+		{
+			return nullptr;
+		}
+
+		TArray<AActor*> AllActors = EditorActorSubsystem->GetAllLevelActors();
+		AActor** FoundActor = AllActors.FindByPredicate([&ActorLabel](const AActor* Actor)
+		{
+			return Actor && Actor->GetActorLabel() == ActorLabel;
+		});
+
+		return FoundActor ? *FoundActor : nullptr;
+	}
 }
 
